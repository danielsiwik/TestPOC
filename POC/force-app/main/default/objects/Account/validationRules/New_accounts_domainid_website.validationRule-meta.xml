<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>New_accounts_domainid_website</fullName>
    <active>true</active>
    <description>New Sales Accounts require a Domain ID or website.</description>
    <errorConditionFormula>AND(
            ISBLANK(domain_id__c),
            ISBLANK(Website),
            $RecordType.Name = &quot;Customer Account&quot;
        )</errorConditionFormula>
    <errorMessage>Domain ID or Website is required to create an Account.</errorMessage>
</ValidationRule>
