# =============================================================================
# GITIGNORE FILE FOR SALESFORCE PROJECT
# =============================================================================
# This file specifies intentionally untracked files that Git should ignore.
# For more information: https://git-scm.com/docs/gitignore
# For useful templates: https://github.com/github/gitignore

# =============================================================================
# SALESFORCE DEVELOPMENT TOOLS & CACHE
# =============================================================================

# Salesforce CLI cache and local development
.sf/
.sfdx/
.localdevserver/
deploy-options.json
.pmdCache

# Copado deployment tool
.copado

# Package manifest (recreated by Copado)
package.xml

# =============================================================================
# LIGHTNING WEB COMPONENTS (LWC)
# =============================================================================

# LWC VSCode autocomplete
**/lwc/jsconfig.json

# LWC Jest coverage reports
coverage/

# =============================================================================
# DEVELOPMENT DEPENDENCIES & BUILD TOOLS
# =============================================================================

# Node.js dependencies
node_modules/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ESLint cache
.eslintcache

# TypeScript build artifacts
tsconfig.json
**/tsconfig*.json
**/*.tsbuildinfo
target/

# =============================================================================
# OPERATING SYSTEM FILES
# =============================================================================

# macOS system files
.DS_Store

# Windows system files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# =============================================================================
# ENVIRONMENT & CONFIGURATION
# =============================================================================

# Local environment variables
.env

# Python virtual environments
**/__pycache__/
**/.venv/
**/venv/

# IDE and editor files
.vscode/
.idea/
.illuminatedCloud/
illuminatedCloud/
/IlluminatedCloud/
.local/*
.cursor/*

# =============================================================================
# SALESFORCE MANAGED PACKAGES - INSTALLED PACKAGES
# =============================================================================
# These are packages that can trigger installation/uninstallation
# and should be managed outside of Git

installedPackages/*

# =============================================================================
# SALESFORCE MANAGED PACKAGES - NAMESPACE PATTERNS
# =============================================================================
# Individual managed package namespaces to ignore

# Core Salesforce and AppExchange packages
*sf_com_apps__*
*sf_chttr_apps__*
*Lucidchart__*
*safebase__*
*commonroom__*
*DNBI__*
*bizible2__*
*EasyDescribe__*
*rhx__*
*rh2__*
*AsanaPublic__*
*AAKCS__*
*tackle__*
*mkto_si__*
*qualtrics__*
*regieai__*

