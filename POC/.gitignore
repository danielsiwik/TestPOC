# =============================================================================
# SALESFORCE METADATA TYPES - ENVIRONMENT SPECIFIC
# =============================================================================
# These metadata types contain environment-specific information
# or are typically managed outside of version control

# Documents (mostly created in Production)
force-app/main/default/documents/*

# Flow definitions (can be environment-specific)
force-app/main/default/flowDefinitions/*

# Static resources (large binary files)
force-app/main/default/staticresources/*
!force-app/main/default/staticresources/Asana_Illustration

# Authentication providers
authprovider/*

# SAML SSO configurations
samlssoconfigs/*

# AI metadata
ai/*

# =============================================================================
# TRANSLATIONS (OPTIONAL)
# =============================================================================
# Translations are complex and can cause deployment failures if fields don't exist
# on the destination org. Uncomment if you want to ignore them entirely.
# If you choose to ignore them, you can deploy translations using Copado Deployer.

# translations/*
# objectTranslations/*

# =============================================================================
# SITES (OPTIONAL)
# =============================================================================
# Sites with domain mapping contain environment-specific information.
# Uncomment if you want to ignore them. Make sure to set up Copado Environment
# Variables to make site config files environment-agnostic.

# sites/*
# siteDotComSites/*

# =============================================================================
# NOTES
# =============================================================================
#

.gitignore_local